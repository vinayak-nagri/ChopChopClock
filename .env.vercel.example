APP_NAME=ChopChopClock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=chopchopclock
DB_USERNAME=your-user
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LARAVEL_STORAGE_PATH=/tmp/laravel-storage
VIEW_COMPILED_PATH=/tmp/laravel-storage/framework/views
APP_CONFIG_CACHE=/tmp/laravel-cache/config.php
APP_EVENTS_CACHE=/tmp/laravel-cache/events.php
APP_PACKAGES_CACHE=/tmp/laravel-cache/packages.php
APP_ROUTES_CACHE=/tmp/laravel-cache/routes.php
APP_SERVICES_CACHE=/tmp/laravel-cache/services.php

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Set these on Vercel for real email delivery.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_username
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@example.com

VITE_APP_NAME="${APP_NAME}"
